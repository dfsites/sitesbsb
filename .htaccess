# Sites Brasília V2 — Apache (KingHost)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + domínio canônico SEM www (decisão do proprietário em 01/10/2026; versão que o Google já indexa)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^sitesbrasilia\.com\.br$ [NC]
  RewriteRule ^ https://sitesbrasilia.com.br%{REQUEST_URI} [R=301,L]

  # Cases de condomínios consolidados em um só (01/10/2026)
  RewriteRule ^portfolio/condominio-(damha-brasilia|le-grand-jardin|le-jardin|alphaville-df|quatro-estacoes|via-horizonte)/?$ /portfolio/sites-de-condominios/ [R=301,L]

  # /index.html (e /pasta/index.html) → URL canônica com barra
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Endereço do formulário da versão anterior (SPA) → novo endpoint
  RewriteRule ^enviar\.php$ /api/contato.php [R=307,L]

  # Nunca servir arquivos sensíveis por engano
  RewriteRule (^|/)\.(git|env) - [F,L]
  RewriteRule \.(sqlite|sqlite3|db|log|bak|sql)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://www.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|avif|png|jpg|jpeg|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Arquivos gerados pelo Astro em /_astro/ têm hash no nome: cache longo e imutável
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
