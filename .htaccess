# Sites Brasília V2 — Apache (KingHost)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + domínio canônico sem www (mesmo comportamento da versão anterior)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://sitesbrasilia.com.br%{REQUEST_URI} [R=301,L]

  # Endereço do formulário da versão anterior (SPA) → novo endpoint
  RewriteRule ^enviar\.php$ /api/contato.php [R=307,L]

  # Nunca servir arquivos sensíveis por engano
  RewriteRule (^|/)\.(git|env) - [F,L]
  RewriteRule \.(sqlite|sqlite3|db|log|bak|sql)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|avif|png|jpg|jpeg|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Arquivos gerados pelo Astro em /_astro/ têm hash no nome: cache longo e imutável
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
